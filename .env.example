# Copy this file to .env.local and fill in real values.
# All values below come from deploying infra/ (see infra/README or the
# project README's Infrastructure section) except the AWS credentials,
# which come from creating an access key for the ripple-api IAM user that
# the CDK stack creates.

# Cognito
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_CLIENT_ID=
COGNITO_USER_POOL_ID=

# DynamoDB
AWS_REGION=us-east-1
DYNAMODB_USERS_TABLE=ripple-users
DYNAMODB_SESSIONS_TABLE=ripple-sessions

# S3 (raw telemetry for model retraining)
S3_TELEMETRY_BUCKET=

# IAM credentials for the ripple-api user (server-side DynamoDB/S3 access).
# Never commit real values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
